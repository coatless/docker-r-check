# ATLAS is no longer in Debian. libatlas3-base in trixie is a transitional
# package with no libraries, so installing it gives reference BLAS.
#
# This arm installs bookworm's 3.10.3-13 instead. libgfortran5 has to be
# installed first, because dpkg -i does not resolve dependencies. The pin
# keeps apt from replacing 3.10.3-13 with trixie's transitional package.
#
# Rconf -ba cannot be used. It passes --with-lapack=no, which pairs ATLAS's
# BLAS with R's own LAPACK 3.12.1, and that needs dgemmtr_, which ATLAS does
# not have. So the arm uses -b, with both alternatives pointed at ATLAS.
# ATLAS's LAPACK reports 3.11.0.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_SYSDEPS="libgfortran5"
RCC_SYSDEB_URLS="http://deb.debian.org/debian/pool/main/a/atlas/libatlas3-base_3.10.3-13_amd64.deb http://deb.debian.org/debian/pool/main/a/atlas/libatlas-base-dev_3.10.3-13_amd64.deb"
RCC_APT_PIN="Package: libatlas3-base libatlas-base-dev|Pin: version 3.10.3-13|Pin-Priority: 1001"
RCC_APT_HOLD="libatlas3-base libatlas-base-dev"
# Checksums of the two .debs, so a replaced file fails the build.
RCC_SYSDEB_SHA256="73f2db3f8bf9adf0beba174e9e3286cafca44db8dc29b8e74608b7709355f93b  2902ce22c8eae6047c937cc0b1eb5ee398a4cd79e1030b89329734175df8d1e3"
RCC_RCONF_FLAGS="-b"
RCC_LDFLAGS=""
RCC_DESC="ATLAS 3.10.3 BLAS and LAPACK 3.11.0 from bookworm binaries"
