# Rconf -bo passes --with-blas=-lopenblas --with-lapack=no. OpenBLAS also
# contains LAPACK, and R reports OpenBLAS's LAPACK 3.12.0 at run time.
#
# Serial, as in CRAN's OpenBLAS checks. The pthread build is always installed
# and has the higher priority, so blas-wiring.sh sets each group explicitly.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH=""
RCC_SYSDEPS="libopenblas0-serial"
RCC_SYSDEB_URLS=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_RCONF_FLAGS="-bo"
RCC_LDFLAGS=""
RCC_DESC="serial OpenBLAS 0.3.29, BLAS and LAPACK 3.12.0"
RCC_SYSDEB_SHA256=""
