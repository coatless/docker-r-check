# The control arm.  Rconf -bi = --with-blas=no --with-lapack=no, i.e. R's own
# reference BLAS and R's internal LAPACK.
#
# Stated explicitly rather than left to Rconf's default, which emits neither
# flag: R-devel's default LAPACK path runs R_LAPACK_SYSTEM_LIB and can adopt
# whatever liblapack the apt layer installed, which would make LAPACK identity
# a property of the package set instead of the image.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH=""
# Declared explicitly even though something usually drags them in: this arm
# points the alternatives AT these paths, so if they are absent the wiring
# fails at build time rather than the arm quietly staying on OpenBLAS.
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_RCONF_FLAGS="-bi"
RCC_LDFLAGS=""
RCC_DESC="reference BLAS and internal LAPACK; control arm"
RCC_SYSDEB_SHA256=""
