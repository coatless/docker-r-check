# Rconf -bo passes --with-blas=-lopenblas --with-lapack=no. OpenBLAS also
# contains LAPACK, and that is the one R reports at run time.
#
# OpenBLAS 0.3.29 on both suites, the version of CRAN's OpenBLAS checks.
# Stable (trixie) has it. Debian testing has 0.3.34, which segfaulted in irlba,
# netrics and rpanel with the Haswell kernels the evaluation pins, on AMD EPYC
# 9V74 and 9V45 runners, where 0.3.29 did not. So on testing the arm fetches
# trixie's serial packages by URL. They need only libc6 (>= 2.38) and
# libgfortran5, and the hold keeps apt from replacing them. The URLs point at
# Debian's pool and need updating if trixie's openblas changes.
#
# Serial, as in CRAN's OpenBLAS checks. The pthread build is always installed
# and has the higher priority, so blas-wiring.sh sets each group explicitly.
RCC_SUITES="testing stable"
# amd64, like every arm. CRAN's BLAS checks run on x86_64, and on arm64 the
# base would lack quarto and openbugs.
RCC_ARCH="amd64"
# The -dev package is required. Rconf -bo links -lopenblas, and the
# unversioned libopenblas.so is in libopenblas-serial-dev. Without it
# configure fails with "BLAS was specified but not available".
if [ "${RCC_SUITE:-testing}" = stable ]; then
    RCC_SYSDEPS="libopenblas0-serial libopenblas-serial-dev"
    RCC_SYSDEB_URLS=""
    RCC_SYSDEB_SHA256=""
    RCC_APT_HOLD=""
else
    RCC_SYSDEPS=""
    RCC_SYSDEB_URLS="http://deb.debian.org/debian/pool/main/o/openblas/libopenblas0-serial_0.3.29+ds-3_amd64.deb http://deb.debian.org/debian/pool/main/o/openblas/libopenblas-serial-dev_0.3.29+ds-3_amd64.deb"
    RCC_SYSDEB_SHA256="edd238e774562e37cb67e01a8698ed4d33b5ba848ca2000c4237f4df124349d1  7677df0b0187cd1b291c6b1f5a77cce701262cd0caf0aed160052fa26a333212"
    RCC_APT_HOLD="libopenblas0-serial libopenblas-serial-dev"
fi
RCC_APT_PIN=""
RCC_RCONF_FLAGS="-bo"
RCC_LDFLAGS=""
RCC_DESC="serial OpenBLAS 0.3.29, BLAS and LAPACK"
