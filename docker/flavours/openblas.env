# Rconf -bo = --with-blas=-lopenblas --with-lapack=no, so OpenBLAS supplies BLAS
# and R's internal LAPACK 3.12.1 supplies LAPACK.  That LAPACK calls dgemmtr_,
# which trixie's OpenBLAS 0.3.29 does define (verified), so the pairing is sound.
#
# Serial, matching bdr.  The pthread build is already present in every image via
# libsuperlu-dev -> libopenblas-dev, and outranks serial 100 to 90, so
# blas-wiring.sh must --set the groups explicitly; installing serial is not enough.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH=""
# The -dev package is not optional: Rconf -bo emits --with-blas=-lopenblas,
# and the unversioned libopenblas.so that link needs ships in
# libopenblas-serial-dev, not in the runtime package.  Without it
# configure fails with "BLAS was specified but not available".
RCC_SYSDEPS="libopenblas0-serial libopenblas-serial-dev"
RCC_SYSDEB_URLS=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_RCONF_FLAGS="-bo"
RCC_LDFLAGS=""
RCC_DESC="OpenBLAS 0.3.29 serial BLAS with R internal LAPACK"
RCC_SYSDEB_SHA256=""
