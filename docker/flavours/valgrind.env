# R built with valgrind instrumentation, with checks run under valgrind, as in
# CRAN's valgrind checks. Rconf -v passes --with-valgrind-instrumentation=2.
# Debian trixie has valgrind 3.24, and CRAN uses 3.27. Apart from that this is
# the reference arm.
#
# R CMD check needs --use-valgrind, and only the check script built on
# tools::check_packages_in_dir() takes check arguments, so this arm uses it.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_SYSDEPS="libblas3 liblapack3 valgrind"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bi -v"
RCC_LDFLAGS=""
RCC_CHECK_ENV="RCC_RUNNER=dir|RCC_CHECK_ARGS=--use-valgrind|RJAVA_JVM_STACK_WORKAROUND=0|R_DONT_USE_TK=true"
RCC_DESC="R's own BLAS and LAPACK, with valgrind instrumentation and checks under valgrind"
