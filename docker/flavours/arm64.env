# The reference arm on arm64, for CRAN's arm64 Linux checks. Those flag a
# package that fails on arm64 and passes on x86, so reference is the control.
#
# AASC serves its archive for x86 only. rcheckserver is an architecture
# independent package, so it installs from that index, and Debian's arm64
# archive supplies what it depends on.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="arm64"
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bi"
RCC_LDFLAGS=""
RCC_DESC="R's own BLAS and LAPACK, on arm64"
