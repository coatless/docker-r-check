# The BLIS binary from Fedora 44's blis-2.0-5 package, the one CRAN's BLIS
# checks load, with Debian's reference LAPACK on top. It shows whether a
# result at CRAN comes from Fedora's build of BLIS.
#
# The binary needs glibc 2.43, so this arm builds on Debian testing, where
# the other arms use trixie. See blisfedora-setup.sh.
RCC_DEBIAN_TAG="forky"
RCC_ARCH="amd64"
RCC_SYSDEPS="liblapack3 liblapack-dev"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_SETUP_SCRIPT="blisfedora-setup.sh"
RCC_RCONF_FLAGS="--with-blas=-lblas --with-lapack=-llapack"
RCC_LDFLAGS=""
RCC_DESC="Fedora 44's serial BLIS 2.0-5 binary, with Debian's reference LAPACK"
