# The BLIS and LAPACK binaries that CRAN's BLIS checks load, from Fedora 44's
# blis-2.0-5 and lapack-3.12.0-11 packages. CRAN's notes on the BLAS checks
# say the BLIS run "reports using the system LAPACK 3.12.0". Debian's own
# BLIS and LAPACK are in the blis arm.
#
# The binaries need glibc 2.43, which Debian testing has and stable (trixie)
# does not, so this arm builds on testing only. See blisfedora-setup.sh.
RCC_SUITES="testing"
RCC_ARCH="amd64"
RCC_SYSDEPS="liblapack3 liblapack-dev"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_SETUP_SCRIPT="blisfedora-setup.sh"
RCC_RCONF_FLAGS="--with-blas=-lblas --with-lapack=-llapack"
RCC_LDFLAGS=""
RCC_DESC="Fedora 44's serial BLIS 2.0-5 and LAPACK 3.12.0 binaries"
