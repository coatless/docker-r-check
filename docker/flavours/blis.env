# Serial BLIS as the BLAS, with Debian's reference LAPACK on top of it. CRAN's
# BLIS checks use Fedora's BLIS 2.0-5 with Fedora's LAPACK 3.12.0, and the
# blisfedora arm loads those two.
#
# Debian testing has BLIS 2.1, the closest Debian build to CRAN's 2.0, and
# the arm installs it with apt. Stable (trixie) has 1.1, so there the arm
# fetches testing's 2.1-1 by URL. It needs only libc6 (>= 2.35), and the hold
# keeps apt from replacing it. The URLs point at Debian's pool and need
# updating when testing moves past 2.1-1. snapshot.debian.org would keep them
# stable, but it served GitHub's runners a different file.
#
# Rconf has no BLIS option, so the flags name -lblas and -llapack, which the
# alternatives point at BLIS and at the reference LAPACK.
RCC_SUITES="testing stable"
RCC_ARCH="amd64"
if [ "${RCC_SUITE:-testing}" = stable ]; then
    RCC_SYSDEPS="liblapack3 liblapack-dev"
    RCC_SYSDEB_URLS="http://deb.debian.org/debian/pool/main/b/blis/libblis4-serial_2.1-1_amd64.deb http://deb.debian.org/debian/pool/main/b/blis/libblis-serial-dev_2.1-1_amd64.deb"
    RCC_SYSDEB_SHA256="8ee382b8e3f54018330ab597cf116126d0a84c937e6c0f8be4c1275dc8629001  d5fdc1b710212c7d013c4e84c33ac44707f9d0f84fbc7be7a8739c8f25bf0f13"
    RCC_APT_HOLD="libblis4-serial libblis-serial-dev"
else
    RCC_SYSDEPS="liblapack3 liblapack-dev libblis4-serial libblis-serial-dev"
    RCC_SYSDEB_URLS=""
    RCC_SYSDEB_SHA256=""
    RCC_APT_HOLD=""
fi
RCC_APT_PIN=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="--with-blas=-lblas --with-lapack=-llapack"
RCC_LDFLAGS=""
RCC_DESC="serial BLIS 2.1 BLAS with Debian's reference LAPACK"
