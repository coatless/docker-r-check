# BLIS 2.0 built from source the way Fedora's blis-2.0-5 package is, with
# Debian's reference LAPACK on top. CRAN's BLIS checks use that Fedora
# package, while Debian has 1.1 and 2.1. See blis20-setup.sh for the build.
#
# Rconf has no BLIS option, so the flags name -lblas and -llapack, which the
# alternatives point at /opt/blis and at the reference LAPACK.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_SYSDEPS="liblapack3 liblapack-dev"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_SETUP_SCRIPT="blis20-setup.sh"
RCC_RCONF_FLAGS="--with-blas=-lblas --with-lapack=-llapack"
RCC_LDFLAGS=""
RCC_DESC="serial BLIS 2.0 built as Fedora builds it, with Debian's reference LAPACK"
