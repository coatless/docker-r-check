# R-devel built with clang 23 and flang 23, with libc++ as the C++ standard
# library. CRAN's clang23 checks use LLVM 23.1.0 built from source so that
# clang++ defaults to libc++.
#
# The compilers come from apt.llvm.org, signed by the key in apt-llvm-org.asc
# (6084 F3CF 814B 57C1 CF12 EFD5 15CF 4D18 AF4F 7421). It has a repository
# for each Debian release and one for unstable, and none for testing. So on
# stable the arm uses the release's own, and on testing the one for
# unstable. Both follow the release/23.x branch and keep one version, so the
# version is not pinned. flavour.txt records what was installed.
#
# Rconf -fc/23 sets CC=clang-23, CXX=clang++-23 and FC=flang-23 and disables
# OpenMP. -bi keeps R's own BLAS and LAPACK, as CRAN's clang build does.
RCC_SUITES="testing stable"
RCC_ARCH="amd64"
RCC_APT_KEY="apt-llvm-org.asc"
if [ "${RCC_SUITE:-testing}" = stable ]; then
    llvm="URIs: https://apt.llvm.org/${RCC_CODENAME:-trixie}/|Suites: llvm-toolchain-${RCC_CODENAME:-trixie}-23"
else
    llvm="URIs: https://apt.llvm.org/unstable/|Suites: llvm-toolchain-23"
fi
RCC_APT_SOURCE="Types: deb|$llvm|Components: main|Architectures: amd64|Signed-By: /etc/apt/keyrings/apt-llvm-org.asc"
# GDAL is built with libc++ by clang-gdal.sh, from these headers.
RCC_SYSDEPS="clang-23 flang-23 libc++-23-dev libc++abi-23-dev cmake libproj-dev libgeos-dev libsqlite3-dev libcurl4-openssl-dev libexpat1-dev libzstd-dev liblzma-dev libdeflate-dev libwebp-dev libopenjp2-7-dev libnetcdf-dev libpcre2-dev"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_SETUP_SCRIPT="clang-gdal.sh"
RCC_RCONF_FLAGS="-fc/23 -bi"
RCC_LDFLAGS=""
RCC_DESC="clang 23 and flang 23 with libc++, R's own BLAS and LAPACK, and GDAL built with libc++"
# While checking, use the QA tree's compiler flags for clang. The default file
# passes -Wall to flang, which warns about it. V8 is linked against its own
# static library, because Debian's libv8 is built with libstdc++ and does not
# link with libc++. CRAN's clang machine does the same. PATH finds the
# gdal-config of the GDAL that clang-gdal.sh builds with libc++.
RCC_CHECK_ENV="R_MAKEVARS_USER=/home/rbuild/.R/Makevars-clang|DOWNLOAD_STATIC_LIBV8=1|PATH=/usr/local/clang/bin:\$PATH"
# Rconf reads CXX_STDLIB from the environment and adds -stdlib=libc++ to CXX.
CXX_STDLIB="libc++"
export CXX_STDLIB
