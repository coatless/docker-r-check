# R-devel built with clang 23 and flang 23, with libc++ as the C++ standard
# library. CRAN's clang23 checks use LLVM 23.1.0 built from source so that
# clang++ defaults to libc++.
#
# The compilers come from apt.llvm.org's repository for trixie, signed by the
# key in apt-llvm-org.asc (6084 F3CF 814B 57C1 CF12 EFD5 15CF 4D18 AF4F 7421).
# That repository follows the release/23.x branch and keeps one version, so
# the version is not pinned. flavour.txt records what was installed.
#
# Rconf -fc/23 sets CC=clang-23, CXX=clang++-23 and FC=flang-23 and disables
# OpenMP. -bi keeps R's own BLAS and LAPACK, as CRAN's clang build does.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_APT_KEY="apt-llvm-org.asc"
RCC_APT_SOURCE="Types: deb|URIs: https://apt.llvm.org/trixie/|Suites: llvm-toolchain-trixie-23|Components: main|Architectures: amd64|Signed-By: /etc/apt/keyrings/apt-llvm-org.asc"
RCC_SYSDEPS="clang-23 flang-23 libc++-23-dev libc++abi-23-dev"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-fc/23 -bi"
RCC_LDFLAGS=""
RCC_DESC="clang 23 and flang 23 with libc++, R's own BLAS and LAPACK"
# Rconf reads CXX_STDLIB from the environment and adds -stdlib=libc++ to CXX.
CXX_STDLIB="libc++"
export CXX_STDLIB
