# R's own BLAS and LAPACK on Debian forky, the current testing suite, which
# has glibc 2.43. The other arms build on trixie, with glibc 2.41. Apart from
# the base this is the reference arm.
RCC_DEBIAN_TAG="forky"
RCC_ARCH="amd64"
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bi"
RCC_LDFLAGS=""
RCC_DESC="R's own BLAS and LAPACK on Debian forky, with glibc 2.43"
