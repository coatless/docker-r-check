# The control arm. Rconf -bi passes --with-blas=no --with-lapack=no, so R
# uses its own BLAS and LAPACK.
#
# The flags are given explicitly because Rconf's default passes neither, and
# R-devel can then pick up a system LAPACK if one is installed.
RCC_DEBIAN_TAG="trixie"
# amd64, like every arm. CRAN's BLAS checks run on x86_64, and on arm64 the
# base would lack quarto and openbugs.
RCC_ARCH="amd64"
# Listed explicitly because the alternatives are pointed at these libraries.
# If they were missing, the build should fail here.
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_RCONF_FLAGS="-bi"
RCC_LDFLAGS=""
RCC_DESC="reference BLAS and internal LAPACK; control arm"
RCC_SYSDEB_SHA256=""
