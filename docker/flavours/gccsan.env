# R and every package it installs built with GCC's address and undefined
# behavior sanitizers, as in CRAN's gcc-ASAN and gcc-UBSAN checks. Rconf -x
# adds -fsanitize=address,undefined,bounds-strict to the C and C++ compilers
# and turns OpenMP off. Apart from that this is the reference arm.
#
# The check settings are the ones CRAN's sanitizer checks use. Leak detection
# is off in every arm's image, because it needs ptrace. Compiling with the
# sanitizers is slow, so the arm uses the check script that installs and
# checks several packages at once.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bi -x"
RCC_LDFLAGS=""
RCC_CHECK_ENV="RCC_RUNNER=dir|UBSAN_OPTIONS=print_stacktrace=1|RJAVA_JVM_STACK_WORKAROUND=0|RGL_USE_NULL=true|R_DONT_USE_TK=true"
RCC_DESC="R's own BLAS and LAPACK, built with GCC's address and undefined behavior sanitizers"
