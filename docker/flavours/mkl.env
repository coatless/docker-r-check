# Serial Intel MKL 2026.1.0, the version in CRAN's MKL checks. Rconf -bm
# passes --with-blas='-lmkl_gf_lp64 -lmkl_core -lmkl_sequential'
# --with-lapack, so MKL supplies both the BLAS and the LAPACK.
#
# MKL is not in Debian. It comes from Intel's apt repository, signed by the
# key in intel-oneapi.asc (E9BF 0AFC 46D6 E8B7 DA58 82F1 BAC6 F0C3 53D0 4109,
# valid until 2027-08-21). intel-oneapi-mkl-core holds the shared libraries
# and the unversioned links that configure's link test needs.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_APT_KEY="intel-oneapi.asc"
RCC_APT_SOURCE="Types: deb|URIs: https://apt.repos.intel.com/oneapi|Suites: all|Components: main|Architectures: amd64|Signed-By: /etc/apt/keyrings/intel-oneapi.asc"
RCC_SYSDEPS="intel-oneapi-mkl-core-2026.1=2026.1.0-236"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bm"
# Rconf passes bare -lmkl_* with no -L. The rpath lets R and the packages it
# compiles find MKL at run time.
RCC_LDFLAGS="LDFLAGS='-L/opt/intel/oneapi/mkl/2026.1/lib -Wl,-rpath,/opt/intel/oneapi/mkl/2026.1/lib'"
RCC_DESC="serial Intel MKL 2026.1.0, BLAS and LAPACK"
