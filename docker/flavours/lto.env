# R and every package it installs built with link-time optimization, which
# is how CRAN's LTO checks find functions declared with different types in
# different files. gcc-ar and gcc-ranlib can read the LTO objects in a
# static library, and LTO=-flto=4 links with four jobs. Rconf has no option
# for this, so the settings go to configure as they are. Apart from that
# this is the reference arm.
#
# R CMD check reads the symbols of the compiled code, and with LTO objects
# that needs gcc-nm. It looks for the program in UserNM.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bi --enable-lto AR=gcc-ar RANLIB=gcc-ranlib LTO=-flto=4"
RCC_LDFLAGS=""
RCC_CHECK_ENV="UserNM=gcc-nm"
RCC_DESC="R's own BLAS and LAPACK, R and packages built with LTO"
