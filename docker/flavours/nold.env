# R built without long double, as in CRAN's noLD checks. Apart from that
# configure option this is the reference arm.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_SYSDEPS="libblas3 liblapack3"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-bi --disable-long-double"
RCC_LDFLAGS=""
RCC_DESC="R's own BLAS and LAPACK, built with --disable-long-double"
