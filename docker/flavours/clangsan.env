# The clang23 arm with clang's address and undefined behavior sanitizers, as
# in CRAN's clang-ASAN checks. Rconf -x adds -fsanitize=address,undefined to
# clang and clang++. flang has no sanitizers. libclang-rt-23-dev holds the
# sanitizer runtime.
#
# CRAN's clang-UBSAN checks use an R built without sanitizers and compile only
# the package under test with -fsanitize=undefined. Here R has both.
# Compiling with the sanitizers is slow, so the arm uses the check script that
# installs and checks several packages at once.
RCC_DEBIAN_TAG="trixie"
RCC_ARCH="amd64"
RCC_APT_KEY="apt-llvm-org.asc"
RCC_APT_SOURCE="Types: deb|URIs: https://apt.llvm.org/trixie/|Suites: llvm-toolchain-trixie-23|Components: main|Architectures: amd64|Signed-By: /etc/apt/keyrings/apt-llvm-org.asc"
RCC_SYSDEPS="clang-23 flang-23 libc++-23-dev libc++abi-23-dev libclang-rt-23-dev"
RCC_SYSDEB_URLS=""
RCC_SYSDEB_SHA256=""
RCC_APT_PIN=""
RCC_APT_HOLD=""
RCC_APT_REMOVE=""
RCC_RCONF_FLAGS="-fc/23 -bi -x"
RCC_LDFLAGS=""
RCC_DESC="clang 23 with libc++ and its address and undefined behavior sanitizers"
RCC_CHECK_ENV="RCC_RUNNER=dir|R_MAKEVARS_USER=/home/rbuild/.R/Makevars-clang|DOWNLOAD_STATIC_LIBV8=1|RJAVA_JVM_STACK_WORKAROUND=0|RGL_USE_NULL=true|R_DONT_USE_TK=true"
# Rconf reads CXX_STDLIB from the environment and adds -stdlib=libc++ to CXX.
CXX_STDLIB="libc++"
export CXX_STDLIB
