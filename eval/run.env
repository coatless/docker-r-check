# What an evaluation run covers. Pushing the branch `evaluate` starts a run.

# CRAN issue kinds to run. The arms are chosen from the kinds that have
# packages listed that day.
KINDS="OpenBLAS MKL BLIS ATLAS clang23 noLD donttest LTO gcc-ASAN gcc-UBSAN clang-ASAN clang-UBSAN valgrind linux-arm64 musl rchk"

# The kinds the daily run covers, the one the publish workflow starts. Its
# results go into README.md. noLD is left out for now. Its packages need
# about 700 dependencies, more than one job has time to install.
DAILY_KINDS="OpenBLAS MKL BLIS clang23"

# Where the arms come from. "published" pulls the images the publish
# workflow last pushed. "build" builds every arm in the run, from the
# newest R-devel and QA revisions, which is how to try a change to an arm.
IMAGES="published"

# The Debian suite of the arms, testing or stable.
SUITE="testing"

# Limit the run to these job labels, or label#shard, for example
# "blis-fedora-skx clang23#3". Empty runs every job.
ONLY=""

# Reuse the package list, CRAN's logs, the R and QA revisions and the CRAN
# snapshot of an earlier run, given by its run number, and compare the new
# results with that run's. Empty takes today's list and revisions.
BASELINE_RUN=""

# Repeat each job's checks under other conditions and compare. "dir" repeats
# them through tools::check_packages_in_dir(), "isolated" in two containers
# with the check itself locked down, "offline" with the network cut off,
# "podman" under rootless Podman.
CONDITIONS=""
