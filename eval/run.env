# What an evaluation run covers. Pushing the branch `evaluate` starts a run.

# CRAN issue kinds to run. The arms are chosen from the kinds that have
# packages listed that day.
KINDS="OpenBLAS MKL BLIS ATLAS clang23"

# Limit the run to these job labels, or label#shard, for example
# "blis-fedora-skx clang23#3". Empty runs every job.
ONLY=""
